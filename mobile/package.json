{
  "name": "cogpit-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cogpit companion mobile app (Capacitor).",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "sync": "cap sync",
    "android": "ionic cap run android -l --external",
    "android:run": "pnpm build:web && cap sync android && cap run android",
    "android:build": "pnpm build:web && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:open": "cap open android",
    "ios": "ionic cap run ios -l --external",
    "ios:run": "pnpm build:web && cap sync ios && cap run ios",
    "build": "pnpm build:web && cap sync android && cap build android --androidreleasetype=APK",
    "assets": "capacitor-assets generate --android --iconBackgroundColor '#17130d' --splashBackgroundColor '#17130d'",
    "cap": "cap",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@ionic/cli": "^7.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
