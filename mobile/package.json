{
  "name": "cogpit-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cogpit companion mobile app (Capacitor).",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "sync": "cap sync",
    "android": "ionic cap run android -l --external",
    "android:run": "pnpm build:web && cap sync android && cap run android",
    "android:build": "pnpm build:web && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:open": "cap open android",
    "ios": "ionic cap run ios -l --external",
    "ios:run": "pnpm build:web && cap sync ios && cap run ios",
    "build": "pnpm build:web && cap sync android && cap build android --androidreleasetype=APK",
    "assets": "capacitor-assets generate --android --iconBackgroundColor '#17130d' --splashBackgroundColor '#17130d'",
    "cap": "cap",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^6.0.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/status-bar": "^6.0.1",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "dompurify": "^3.4.18",
    "marked": "^18.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@ionic/cli": "^7.2.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.4.5"
  }
}
