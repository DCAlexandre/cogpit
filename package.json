{
  "name": "cogpit",
  "version": "0.1.0",
  "description": "A steampunk cockpit for your Claude Code sessions — browse, resume and clean up every CLI conversation from one window.",
  "author": "Alexandre Da Costa",
  "license": "MIT",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/DCAlexandre/cogpit",
  "repository": {
    "type": "git",
    "url": "https://github.com/DCAlexandre/cogpit.git"
  },
  "bugs": {
    "url": "https://github.com/DCAlexandre/cogpit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "sessions",
    "electron",
    "terminal",
    "ai"
  ],
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "setup:terminal": "node scripts/setup-terminal.cjs",
    "rebuild": "electron-rebuild -f -w @homebridge/node-pty-prebuilt-multiarch",
    "gen:icon": "node scripts/gen-icon.cjs",
    "gen:tray-icons": "node scripts/gen-tray-icons.cjs",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "mobile:dev": "pnpm --filter cogpit-mobile dev",
    "mobile:build": "pnpm --filter cogpit-mobile build:web",
    "android": "pnpm --filter cogpit-mobile android",
    "ios": "pnpm --filter cogpit-mobile ios",
    "apk": "pnpm --filter cogpit-mobile build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.7.1",
    "ws": "^8.23.0"
  },
  "optionalDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.15.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@homebridge/node-pty-prebuilt-multiarch"
    ]
  }
}
