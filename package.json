{
  "name": "cogpit",
  "version": "0.1.0",
  "description": "A steampunk cockpit for your Claude Code sessions — browse, resume and clean up every CLI conversation from one window.",
  "author": "Alexandre Da Costa",
  "license": "MIT",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/DCAlexandre/cogpit",
  "repository": {
    "type": "git",
    "url": "https://github.com/DCAlexandre/cogpit.git"
  },
  "bugs": {
    "url": "https://github.com/DCAlexandre/cogpit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "sessions",
    "electron",
    "terminal",
    "ai"
  ],
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "setup:terminal": "node scripts/setup-terminal.cjs",
    "rebuild": "electron-rebuild -f -w @homebridge/node-pty-prebuilt-multiarch",
    "gen:icon": "node scripts/gen-icon.cjs",
    "gen:tray-icons": "node scripts/gen-tray-icons.cjs",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "tailwind-merge": "^3.7.0"
  },
  "optionalDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@homebridge/node-pty-prebuilt-multiarch"
    ]
  }
}
